   "source": [
    "s = input('Introduce un número entero no negativo: ')\n",
    "n = int(s)\n",
    "print(f'Factorial de {n} es {factorial(n)}')\n",
    "def factorial(n):\n",
    "    result = 1\n",
    "    for i in range(2, n+1):\n",
    "        result *= i\n",
    "    return result\n"
   ]
  }
