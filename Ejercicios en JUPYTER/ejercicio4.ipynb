   "source": [
    "cadena = input('Introduce una cadena de texto: ')\n",
    "    \n",
    "cadena_limpia = cadena.replace(' ', '').lower()\n",
    "    \n",
    "if cadena_limpia == cadena_limpia[::-1]:\n",
    "    print(f'\"{cadena}\" es un palíndromo')\n",
    "else:\n",
    "    print(f'\"{cadena}\" no es un palíndromo')"
   ]
  }
